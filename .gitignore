# Generated by the build system (see README.md). Everything here can be recreated by the scripts.

# Shared: patched engine headers + UHT output + import libraries (New-ArkSdk.ps1), probe SDK (Test-LayoutIndependence.ps1)
/SDK/
/SDP/
# Shared intermediates: PDB text dumps (~12 GB), engine UHT run, logs
/Intermediate/

# Per plugin: objects, UHT output, link output, UBT baseline host project, probe build, staged plugin.
# Plugins/<Plugin>/Build/Config/ is NOT ignored: the captured build environment is input to Build.ps1
# and recreating it needs a stock UBT build (Tools\Capture-UbtBaseline.ps1).
/Plugins/*/Build/Intermediate/
/Plugins/*/Build/Probe_Interm/
/Plugins/*/Build/Output/

# Tools\PdbLayout build output (rebuilt on first use by Initialize-PdbLayout)
/Tools/bin/
/Tools/PdbLayout/bin/
/Tools/PdbLayout/obj/

# Editors
.vs/
.vscode/
*.user

# Don't check in plugin sources
/Plugins